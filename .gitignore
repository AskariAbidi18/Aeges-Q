!artifacts/qml/qml_circuit_c_clean_v1/matched_model_comparison.csv
!artifacts/qml/qml_circuit_c_clean_v1/matched_comparison_metadata.json

!artifacts/qml/classical_rf_matched_4pca_v1/
artifacts/qml/classical_rf_matched_4pca_v1/*
!artifacts/qml/classical_rf_matched_4pca_v1/experiment_config.json
!artifacts/qml/classical_rf_matched_4pca_v1/validation_calibration.json
!artifacts/qml/classical_rf_matched_4pca_v1/final_test_metrics.json
!artifacts/qml/classical_rf_matched_4pca_v1/matched_model_comparison.csv


# Frontend - Node.js / React / Vite
app/frontend/node_modules/
app/frontend/dist/
app/frontend/coverage/


# Frontend environment files
app/frontend/.env
app/frontend/.env.*
!app/frontend/.env.example


# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*


# Post-quantum cryptography (PQC)
artifacts/pqc/*

# Keep compact, reproducibility-critical PQC results
!artifacts/pqc/pqc_environment_metadata.json
!artifacts/pqc/pqc_benchmark_config.json
!artifacts/pqc/pqc_benchmark_summary.csv
!artifacts/pqc/pqc_cryptographic_object_sizes.csv
!artifacts/pqc/pqc_classical_comparison.csv
!artifacts/pqc/pqc_raw_benchmark_results.csv

# Keep directory placeholder
!artifacts/pqc/.gitkeep

